{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build"],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}